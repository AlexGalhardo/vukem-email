APP_NAME=Vukem Email
APP_ENV=development
APP_DEBUG=true
APP_KEY=
APP_PREVIOUS_KEYS=
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# SQLite locally; use Railway PostgreSQL's DATABASE_URL in production.
DATABASE_URL=file:storage/database.sqlite

# Create a Web application client in Google Cloud Console.
# Authorized redirect URI: APP_URL/auth/google/callback
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

# Use resend in production, array locally (no external delivery).
MAIL_MAILER=array
MAIL_FROM=newsletter@hexascore.app
RESEND_API_KEY=

# Persistent queue, encrypted confirmation email payloads.
QUEUE_CONNECTION=database
QUEUE_CONCURRENCY=1
QUEUE_IN_SERVE=true
CACHE_STORE=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=24h
SESSION_IDLE_TIMEOUT=2h

# Railway edge: verify peer addresses in logs before changing these.
# TRUSTED_PROXIES=100.64.0.0/24
# CLIENT_IP_HEADER=X-Real-IP
# TRUST_FORWARDED_PROTO=true
