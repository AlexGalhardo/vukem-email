{
	admin off
	auto_https off
}

:{$PORT:3000} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# /_astro/ is content-hashed build output.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_astro/*
	header @pages Cache-Control "public, max-age=300"

	file_server

	handle_errors {
		rewrite * /404.html
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			-Server
		}
		file_server
	}
}
