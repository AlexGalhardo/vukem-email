#!/bin/sh
message=$(head -n 1 "$1")
case "$message" in
  feat\(*\):\ *|fix\(*\):\ *|perf\(*\):\ *|refactor\(*\):\ *|docs\(*\):\ *|test\(*\):\ *|build\(*\):\ *|ci\(*\):\ *|chore\(*\):\ *|style\(*\):\ *|revert\(*\):\ *|feat:\ *|fix:\ *|perf:\ *|refactor:\ *|docs:\ *|test:\ *|build:\ *|ci:\ *|chore:\ *|style:\ *|revert:\ *) exit 0 ;;
esac
echo "Use Conventional Commits: type(scope): description" >&2
exit 1
